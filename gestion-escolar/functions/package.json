    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  },
  "private": true
}
