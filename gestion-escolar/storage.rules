rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Archivos de admisión subidos por los aspirantes (documentos, pago, contrato).
    // Se permite subir sin necesidad de cuenta (el aspirante entra con código),
    // pero con límites: máximo 10 MB y solo imágenes o PDF.
    match /admissions/{admissionId}/{category}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType == 'application/pdf'
                   );
    }

    // Pagos/contratos de alumnos de reingreso (antiguo ingreso).
    match /reingreso/{carnet}/{category}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType == 'application/pdf'
                   );
    }

    // Imágenes de portadas del sitio público, editadas desde el Gestor de
    // Página Web. Lectura pública; escritura solo de imágenes hasta 5 MB.
    match /portadas/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Todo lo demás: bloqueado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
